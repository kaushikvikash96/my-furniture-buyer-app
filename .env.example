# Copy this file to .env to run the app.
# The database is just a file on disk, created by `npm run db:reset`.
DATABASE_URL="file:./dev.db"

# Source for the real product catalogue, used by `npm run db:import-catalog`.
# Ask the team for the real value — never commit it.
CATALOG_MONGODB_URI="mongodb+srv://USER:PASSWORD@HOST/catalog?appName=Hackathon"
