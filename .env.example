# Copy this file to .env to run the app.
# The database is just a file on disk, created by `npm run db:reset`.
DATABASE_URL="file:./dev.db"

# The furniture shop's catalogue and orders API — this app's real balance and
# real orders come from here (architecture.md §7). Ask the team for the real
# key — never commit it. Server-side only — do not rename this with a
# NEXT_PUBLIC_ prefix.
COGNITIVO_API_BASE_URL="https://day1.training.cognitivo.com.au"
COGNITIVO_API_KEY="YOUR_KEY_HERE"
COGNITIVO_USER_ID="cognitivo020"

# Powers the "Ask" assistant text box (app/assistant) — an Azure OpenAI
# deployment used to reason over catalogue search results in plain English.
# Server-side only — do not rename this with a NEXT_PUBLIC_ prefix.
AZURE_OPENAI_ENDPOINT="YOUR_AZURE_ENDPOINT_HERE"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="YOUR_DEPLOYMENT_NAME_HERE"
AZURE_OPENAI_API_KEY="YOUR_KEY_HERE"
